{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-cli",
    "rootDir": "./cli",
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["cli/**/*"],
  "exclude": ["node_modules", "dist", "dist-cli", "src"]
}
